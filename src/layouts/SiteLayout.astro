---
import '../styles/globals.scss';

const { title = 'Jamstack Handbook', description, canonical } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/images/favicon-512x512.png" />
    {title === 'Jamstack Handbook' && <>
      <meta property="og:url" content="https://jamstackhandbook.com" />
      <meta property="og:type" content="book" />
      <meta property="og:title" content="Jamstack Handbook" />
      <meta property="og:description" content="Building fast, dynamic apps with Javascript and the static web" />
      <meta property="og:image" content="https://jamstackhandbook.com/images/jamstack-handbook-social.jpg" />
      <meta property="og:image:width" content="2024" />
      <meta property="og:image:height" content="1012" />
      <meta property="og:image:alt" content="Jamstack Handbook - Building fast, dynamic apps with Javascript and the static web" />
      <meta property="twitter:card" content="summary_large_image" />
      <meta property="twitter:image" content="https://jamstackhandbook.com/images/jamstack-handbook-social.jpg" />
      <meta property="twitter:site" content="@colbyfayock" />
      <meta property="twitter:creator" content="@colbyfayock" />
    </>}
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=UA-177634096-1"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){window.dataLayer.push(arguments);}
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', 'UA-177634096-1', { page_path: window.location.pathname });
    </script>
  </head>
  <body><slot /></body>
</html>
